# Production build of Dan's UI site (block52-ui-fork on DigitalOcean): the hosted club back office.
# The console is served at the root and its service under /api. Settings in DigitalOcean override these.
VITE_CLUB_CONSOLE_URLS=https://block52-club-xc92p.ondigitalocean.app
VITE_CLUB_SERVICE_URLS=https://block52-club-xc92p.ondigitalocean.app/api

# Club mode, live (block52-club#54): club username/password accounts, game actions through the Go signer on
# DigitalOcean Functions, balances and tables from the club API, no node dropdown. "Club login" stays for staff.
VITE_SIGNER_URL=https://faas-syd1-c274eac6.doserverless.co/api/v1/web/fn-b6eae68f-e3b4-4555-896a-5d9a2d78e722/signer/rpc
VITE_FEATURE_CLUB_ACCOUNTS=true
VITE_FEATURE_API_READS=true
VITE_FEATURE_NODE_SELECTOR=false

# Block52 Flagship is the default look (new lobby, violet pages, Flagship table). Players can switch to Traditional in the header.
VITE_SITE_LOOK=flagship
